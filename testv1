-- Buat DUA folder yang berbeda agar AutoBuild tidak bingung
local woodFolder = workspace:FindFirstChild("Builds") or Instance.new("Folder", workspace)
woodFolder.Name = "Builds"

local structureFolder = workspace:FindFirstChild("BuildsStructures") or Instance.new("Folder", workspace)
structureFolder.Name = "BuildsStructures"

for _, v in pairs(partTable) do
	local modelTemplate = game.ReplicatedStorage.ClientItemInfo:FindFirstChild(v.Name)
	if not modelTemplate then continue end

	local part = modelTemplate:FindFirstChildOfClass('Model'):Clone()
	part:SetPrimaryPartCFrame(v.CFrame)
	part.Name = v.Name

	local targetColor = nil
	local targetMaterial = nil

	-- [ PENGATURAN FOLDER & DATA AUTOBUILD ]
	if v.TreeValue then
		-- Jika ini KAYU: Masukkan ke folder 'Builds' dan beri TreeValue
		part.Parent = woodFolder
		local treeValue = Instance.new("StringValue", part)
		treeValue.Name = "TreeValue"
		treeValue.Value = v.TreeValue

		-- Siapkan warnanya
		if v.TreeValue == "Generic" then targetColor = Color3.fromRGB(204, 142, 105)
		elseif v.TreeValue == "Oak" then targetColor = Color3.fromRGB(234, 184, 146)
		elseif v.TreeValue == "Cherry" then targetColor = Color3.fromRGB(163, 75, 75)
		elseif v.TreeValue == "Fir" then targetColor = Color3.fromRGB(215, 197, 154)
		elseif v.TreeValue == "Birch" then targetColor = Color3.fromRGB(205, 205, 205)
		elseif v.TreeValue == "Walnut" then targetColor = Color3.fromRGB(105, 64, 40)
		elseif v.TreeValue == "Koa" then targetColor = Color3.fromRGB(143, 76, 42)
		elseif v.TreeValue == "Volcano" then targetColor = Color3.fromRGB(255, 0, 0)
		elseif v.TreeValue == "GreenSwampy" then targetColor = Color3.fromRGB(52, 142, 64)
		elseif v.TreeValue == "GoldSwampy" then targetColor = Color3.fromRGB(226, 155, 64)
		elseif v.TreeValue == "Palm" then targetColor = Color3.fromRGB(226, 220, 188)
		elseif v.TreeValue == "SnowGlow" then targetColor = Color3.fromRGB(255, 255, 0)
		elseif v.TreeValue == "Frost" then targetColor = Color3.fromRGB(159, 243, 233)
		elseif v.TreeValue == "CaveCrawler" then targetColor = Color3.fromRGB(16, 42, 220)
		elseif v.TreeValue == "BlueSpruce" then targetColor = Color3.fromRGB(159, 173, 192)
		elseif v.TreeValue == "LoneCave" then targetColor = Color3.fromRGB(248, 248, 248)
		elseif v.TreeValue == "Spooky" then
			targetMaterial = Enum.Material.Granite
			targetColor = Color3.fromRGB(170, 85, 0)
		elseif v.TreeValue == "SpookyNeon" then
			targetMaterial = Enum.Material.Neon
			targetColor = Color3.fromRGB(170, 85, 0)
		end
	else
		-- Jika ini KACA/PINTU: Masukkan ke folder 'BuildsStructures' dan beri nama Item Box
		part.Parent = structureFolder
		local boxValue = Instance.new("StringValue", part)
		boxValue.Name = "PurchasedBoxItemName"
		boxValue.Value = v.Name
	end

	-- [ PENERAPAN WARNA & TRANSPARANSI ]
	for _, _Part in pairs(part:GetChildren()) do
		if _Part:IsA('BasePart') and _Part.Transparency == 0 then
			_Part.Transparency = 0.3 -- Efek Preview

			-- Jika benda ini kayu dan punya target warna, warnai seluruhnya
			if targetColor then
				_Part.Color = targetColor
				if targetMaterial then
					_Part.Material = targetMaterial
				end
			end
		end
	end
end
